# Puerto del servidor (opcional, por defecto 4000)
PORT=4000

# Interfaz de red en la que escucha el servidor (opcional, por defecto 0.0.0.0).
# Si pones Nginx delante como proxy inverso (recomendado con HTTPS/dominio propio),
# usa 127.0.0.1 para que el puerto no quede accesible directamente desde fuera.
HOST=0.0.0.0

# Clave de la API de Anthropic, necesaria solo para generar roscos con IA
ANTHROPIC_API_KEY=

# Modelo de Anthropic a usar para generar roscos (opcional)
ROSCO_AI_MODEL=claude-sonnet-5
